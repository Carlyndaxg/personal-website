{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" },
    { "src": "public/**/*", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/server.js" },
    { "src": "/projects", "dest": "/server.js" },
    { "src": "/about", "dest": "/server.js" },
    { "src": "/index.html", "dest": "/server.js" },
    { "src": "/projects.html", "dest": "/server.js" },
    { "src": "/about.html", "dest": "/server.js" },
    { "src": "/.*", "dest": "/server.js" }
  ]
}
